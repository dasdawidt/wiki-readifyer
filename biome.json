{
    "$schema": "https://biomejs.dev/schemas/2.3.6/schema.json",
    "root": true,
    "files": {
        "ignoreUnknown": true
    },
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true,
        "defaultBranch": "main"
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "operatorLinebreak": "before",
            "quoteStyle": "single"
        }
    }
}
